# Copy to .env and adjust. Everything here is optional.

# Where TheBar listens. 0.0.0.0 = all IPv4 interfaces (not IPv6).
# Use your LAN IP (e.g. 192.168.1.10:8800) to bind to that network only.
THEBAR_LISTEN=0.0.0.0:8800

# Disk usage bars in the header: Label=/path, comma separated.
# Paths must be visible inside the container (see volumes in docker-compose.yml).
# End a path with "?" for a mount point that is often empty (e.g. for USB
# drives): its bar only shows while something is mounted there.
THEBAR_DISKS=System=/opt
# more disks (mount them in docker-compose.override.yml first):
# THEBAR_DISKS=System=/opt,Storage=/mnt/storage,USB=/mnt/usb?

# Password: normally you choose it in the browser the first time you open
# TheBar (and can change it in the settings). To set it from here instead,
# uncomment this; it then can't be changed in the app. Plain text, so keep
# this file private:
# THEBAR_PASSWORD=

# First-time setup only works when TheBar is opened by IP address or a local
# name (.local, .lan, ...). To allow another name, list it here:
# THEBAR_ALLOWED_HOSTS=thebar.example.org

# Turn the login off entirely (not recommended):
# THEBAR_AUTH=off

# Where Nginx Proxy Manager keeps its generated proxy host configs.
# Normally found automatically from the NPM container.
# THEBAR_NPM_DIR=/opt/proxy/data/nginx/proxy_host
